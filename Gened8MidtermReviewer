# EXAM
# --------------------------------------------------

for number, q in enumerate(questions, start=1):

    # Keep track of the correct answer before shuffling
    correct_answer = q["choices"][q["answer"]]

    # Shuffle choices
    choices = q["choices"].copy()
    random.shuffle(choices)

    print("\n" + "-" * 60)
    print(f"Question {number}/{total}")
    print("-" * 60)
    print(q["question"])

    letters = ["A", "B", "C", "D"]

    for i, choice in enumerate(choices):
        print(f"{letters[i]}. {choice}")

    # Get answer
    while True:
        user_answer = input("\nYour answer (A/B/C/D): ").upper().strip()

        if user_answer in letters:
            break

        print("Invalid answer. Please choose A, B, C, or D.")

    selected_index = letters.index(user_answer)
    selected_answer = choices[selected_index]

    # Check answer
    if selected_answer == correct_answer:
        score += 1
        print("✓ CORRECT!")
    else:
        print("✗ WRONG!")
        print(f"Correct answer: {correct_answer}")


